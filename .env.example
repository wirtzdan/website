AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
RAINDROP_ACCESS_TOKEN=
BUTTONDOWN_API_KEY=
USE_OFFICIAL_NOTION_API=
NOTION_TOKEN=
NODE_ENV=
NOTION_BLOG_DATABASE_ID=
NOTION_PAGES_DATABASE_ID=
NOTION_BOOKS_DATABASE_ID=
NOTION_PHOTOS_DATABASE_ID=

# Distributed rate limit for POST /api/addSubscriber and POST /api/sendSuggestion.
# Create a Redis database at https://upstash.com and paste the REST URL and token.
# Leave these empty locally; each serverless instance then uses an in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for POST /api/revalidate. Refreshes cached Notion, Airtable,
# and Raindrop data without waiting out the hourly revalidate window.
# Send it as `Authorization: Bearer <secret>` or `x-revalidate-secret`.
# Generate a long random value and add it in the host's env settings.
# Never commit a real value. Leave this empty locally.
REVALIDATE_SECRET=
